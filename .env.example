# ==============================================================================
# Furniture Prompt Generator Studio - Plantilla de Variables de Entorno
# Copia este archivo a `.env` y configura tus valores reales:
# cp .env.example .env
# ==============================================================================

# Clave API de Google Gemini (Requerida para análisis visual y generación de prompts)
# Obtén tu clave en Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=tu_clave_api_gemini_aqui

# Puerto de escucha del servidor local (Opcional, por defecto 8000)
PORT=8000

# Host de escucha local (Opcional, por defecto 0.0.0.0)
HOST=0.0.0.0

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
